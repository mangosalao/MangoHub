# Mango Hub - Configuración
# ============================

# Puerto del servidor (por defecto 3000)
PORT=3000

# Secreto para las sesiones de Express (cambiar por un valor seguro)
SESSION_SECRET=tu_secreto_super_seguro

# Autenticación Twitch OAuth
TWITCH_CLIENT_ID=tu_twitch_client_id
TWITCH_CLIENT_SECRET=tu_twitch_client_secret

# URL base de la aplicación (cambiar en producción)
# Ejemplo: https://mangohub.onrender.com
BASE_URL=http://localhost:3000

# Nivel de logging: debug, info, warn, error (por defecto: info)
LOG_LEVEL=info